# Base URL of the deployed API, WITHOUT a trailing slash (set this in Vercel -> Settings -> Environment Variables).
# Leave empty in local dev: Vite proxies /api to http://localhost:4000.
# VITE_API_URL=https://caffluck-api.onrender.com

# Where the map starts if the browser denies GPS (defaults to Manila)
VITE_DEFAULT_LAT=14.5995
VITE_DEFAULT_LNG=120.9842

# How far "Randomize Me!" and the map pins look, in meters (API caps this at MAX_RADIUS_M)
VITE_SEARCH_RADIUS_M=5000

# Optional: your own OSRM server. Defaults to the public demo server (light use only).
# VITE_OSRM_URL=https://router.project-osrm.org
